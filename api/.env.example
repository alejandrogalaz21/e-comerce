# App
PORT=8080
NODE_ENV=development
APP_NAME=ecommerce-api
APP_VERSION=0.1.0

# Auth
# Leave empty to get a random secret per boot; any value set here must be 16+ chars
JWT_SECRET=
# JWT_EXPIRES_IN: lifetime of the issued access token (zeit/ms format). Default 1d
JWT_EXPIRES_IN=1d

# Security
# CORS_ORIGINS: comma-separated origins allowed to call the API.
# Defaults to http://localhost:3000 (the web container). Never '*'.
CORS_ORIGINS=http://localhost:3000
# IMPORT_RATE_LIMIT: CSV imports allowed per minute. Default 20.
IMPORT_RATE_LIMIT=20

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce
# DB_SYNC: optional dev-only override to enable TypeORM synchronize (default false; schema is managed by migrations)
# DB_SYNC=false
# DB_MIGRATIONS_RUN: run pending migrations automatically on boot (default true)
# DB_MIGRATIONS_RUN=true

# Seed

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
