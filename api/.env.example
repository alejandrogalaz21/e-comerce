# App
PORT=8080
NODE_ENV=development
APP_NAME=ecommerce-api
APP_VERSION=0.1.0

# Auth
# Leave empty to get a random secret per boot; any value set here must be 16+ chars
JWT_SECRET=
# JWT_EXPIRES_IN: lifetime of the issued access token (zeit/ms format). Default 1d
JWT_EXPIRES_IN=1d

# Security
# CORS_ORIGINS: comma-separated origins allowed to call the API.
# Defaults to http://localhost:3000 (the web container). Never '*'.
CORS_ORIGINS=http://localhost:3000
# IMPORT_RATE_LIMIT: CSV imports allowed per minute. Default 20.
IMPORT_RATE_LIMIT=20
# ORDER_RATE_LIMIT: orders one address may place per minute. Default 20.
ORDER_RATE_LIMIT=20
# THROTTLE_LIMIT: ceiling for every other route, per minute. Default 300.
THROTTLE_LIMIT=300
# TRUST_PROXY_HOPS: how many reverse proxies sit in front of the API. Rate
# limits count by client IP, and behind a proxy every request carries the
# proxy's address unless this says how far down X-Forwarded-For to trust.
# Default 0 (direct connection). Set it to the real hop count in production:
# trusting the whole chain lets a client forge an address for a fresh counter.
TRUST_PROXY_HOPS=0

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce
# DB_SYNC: optional dev-only override to enable TypeORM synchronize (default false; schema is managed by migrations)
# DB_SYNC=false
# DB_MIGRATIONS_RUN: run pending migrations automatically on boot (default true)
# DB_MIGRATIONS_RUN=true

# Seed

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
