# Origin of the API as seen from the browser.
# Local development (`npm run dev`): the API runs on 8080.
# Docker Compose: the api container is published on 4000 and the compose file
# passes this in as a build argument, so this file is not read there.
VITE_SERVER_URL=http://localhost:8080

# Sub-path the app is served from, when it is not the domain root (e.g. /shop).
VITE_BASE_PATH=

# Origin static assets are served from, when they are not served by the app.
VITE_ASSET_URL=
