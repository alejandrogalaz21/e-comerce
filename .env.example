# Variables read by docker-compose.yml. Every one has a default, so the stack
# starts without this file. Copy it to .env only to override something.

# Database credentials, applied to the db container and to the API together so
# the two cannot drift apart.
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=ecommerce

# Leave empty to get a random signing key per boot: sessions then end when the
# container restarts, which is loud and harmless. A value must be 16+ chars; a
# known placeholder like "changeme" stops the boot on purpose.
JWT_SECRET=

# Where the browser calls the API. Baked into the front at build time, so
# changing it needs `docker compose up --build`.
VITE_SERVER_URL=http://localhost:4000

# Host-side ports only, for when one is already taken on your machine. The
# containers always reach each other on their internal ports, so changing these
# changes nothing inside the stack. If you move API_PORT_HOST, move
# VITE_SERVER_URL with it — the browser calls the API from outside Docker.
DB_PORT_HOST=5432
API_PORT_HOST=4000
WEB_PORT_HOST=3000
REDIS_PORT_HOST=6379
