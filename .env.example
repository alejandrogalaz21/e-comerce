# Variables para docker-compose (todas tienen default — el compose levanta sin .env)
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=ecommerce
# Leave empty to get a random secret per boot; any value set here must be 16+ chars
JWT_SECRET=
# URL del API vista desde el navegador (host), usada en build del front
VITE_SERVER_URL=http://localhost:4000
